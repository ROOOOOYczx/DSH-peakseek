+++ b/packages/client/ui-peak-pricing/src/client/PeakPricingNotice.tsx
@@ -0,0 +1,139 @@
+import { useEffect, useLayoutEffect, useRef, useState } from 'react'
+import { HoverCard } from '@deepseek-ai/dsh-client-ui-primitives'
+import { pricePeriodAt } from '../pricing.ts'
+import type { ModelPricing, PricePeriod, PricingSnapshot } from '../pricing.ts'
+import type { PeakPricingProps } from './contract.ts'
+import css from './PeakPricingNotice.module.css'
+
+const PERIOD_LABEL: Record<PricePeriod, string> = { idle: '空闲时段', peak: '高峰时段' }
+const PERIOD_NOTICE: Record<PricePeriod, string> = { idle: '现在是梁文谷时间', peak: '现在是梁文峰时间' }
+
+function useCurrentPeriod(): PricePeriod {
+  const [period, setPeriod] = useState<PricePeriod>(() => pricePeriodAt(new Date()))
+
+  useEffect(() => {
+    const update = () => setPeriod(pricePeriodAt(new Date()))
+    const timer = window.setInterval(update, 30_000)
+    return () => window.clearInterval(timer)
+  }, [])
+
+  return period
+}
+
+function price(value: number): string {
+  return `¥${String(value)}`
+}
+
+function modelPanel(model: ModelPricing): React.ReactNode {
+  return (
+    <section className={css.model} key={model.id}>
+      <div className={css.modelName}>{model.version}</div>
+      <div className={css.priceGrid}>
+        <span>输入 · 缓存命中</span>
+        <strong>{price(model.inputCacheHit.idle)} / {price(model.inputCacheHit.peak)}</strong>
+        <span>输入 · 缓存未命中</span>
+        <strong>{price(model.inputCacheMiss.idle)} / {price(model.inputCacheMiss.peak)}</strong>
+        <span>输出</span>
+        <strong>{price(model.output.idle)} / {price(model.output.peak)}</strong>
+      </div>
+    </section>
+  )
+}
+
+function PricingPanel({ state, currentPeriod }: { state: { status: 'loading' } | { status: 'error'; message: string } | { status: 'ready'; snapshot: PricingSnapshot }; currentPeriod: PricePeriod }): React.ReactNode {
+  if (state.status === 'loading') return <div className={css.status}>正在读取官方价格…</div>
+  if (state.status === 'error') {
+    return (
+      <div className={css.statusError} role="alert">
+        <div>价格暂时无法读取</div>
+        <div className={css.errorDetail}>{state.message}</div>
+        <a href="https://api-docs.deepseek.com/zh-cn/quick_start/pricing/" target="_blank" rel="noreferrer">打开官方定价页</a>
+      </div>
+    )
+  }
+  return (
+    <div className={css.panel}>
+      <div className={css.title}>DeepSeek 今日模型价格</div>
+      <div className={css.period}>当前：{PERIOD_LABEL[currentPeriod]} · 元 / 百万 tokens</div>
+      {state.snapshot.models.map(modelPanel)}
+      <div className={css.legend}>每行：空闲 / 高峰</div>
+      <a className={css.source} href={state.snapshot.source} target="_blank" rel="noreferrer">查看官方定价页 ↗</a>
+    </div>
+  )
+}
+
+/**
+ * Centered composer hint. The entry is absolute inside the existing composer
+ * card, so it occupies the visual gap between permission and model controls
+ * without changing the input row's measured width.
+ * @param props - slot owner/runtime share and the Host pricing callback.
+ * @returns the hover target and its floating pricing card.
+ */
+export function PeakPricingNotice({ getPricing }: PeakPricingProps): React.ReactNode {
+  const rootRef = useRef<HTMLDivElement>(null)
+  const [state, setState] = useState<{ status: 'loading' } | { status: 'error'; message: string } | { status: 'ready'; snapshot: PricingSnapshot }>({ status: 'loading' })
+  const [centerOffset, setCenterOffset] = useState<number | null>(null)
+  const currentPeriod = useCurrentPeriod()
+
+  useLayoutEffect(() => {
+    const root = rootRef.current
+    if (root === null) return
+    const card = root.closest<HTMLElement>('[data-composer-card]')
+    if (card === null) return
+    const tools = card.querySelector<HTMLElement>('[data-composer-tools]')
+    const trailing = card.querySelector<HTMLElement>('[data-composer-trailing]')
+    if (tools === null || trailing === null) return
+
+    const updatePosition = () => {
+      const cardRect = card.getBoundingClientRect()
+      const toolsRect = tools.getBoundingClientRect()
+      const trailingRect = trailing.getBoundingClientRect()
+      const gap = trailingRect.left - toolsRect.right
+      const center = gap >= 0
+        ? (toolsRect.right + trailingRect.left) / 2 - cardRect.left
+        : cardRect.width / 2
+      setCenterOffset(previous => previous !== null && Math.abs(previous - center) < 0.5 ? previous : center)
+    }
+
+    updatePosition()
+    window.addEventListener('resize', updatePosition)
+    if (typeof ResizeObserver === 'undefined') {
+      return () => window.removeEventListener('resize', updatePosition)
+    }
+    const observer = new ResizeObserver(updatePosition)
+    observer.observe(card)
+    observer.observe(tools)
+    observer.observe(trailing)
+    return () => {
+      observer.disconnect()
+      window.removeEventListener('resize', updatePosition)
+    }
+  }, [])
+
+  useEffect(() => {
+    let alive = true
+    void getPricing().then((snapshot) => {
+      if (alive) setState({ status: 'ready', snapshot })
+    }, (error: unknown) => {
+      if (alive) setState({ status: 'error', message: error instanceof Error ? error.message : String(error) })
+    })
+    return () => { alive = false }
+  }, [getPricing])
+
+  return (
+    <div ref={rootRef} className={css.root} style={{ left: centerOffset ?? '50%' }}>
+      <HoverCard
+        trigger="click"
+        placement="top"
+        anchor={(
+          <button type="button" className={css.anchor} title="点击查看或关闭今日模型价格">
+            <span className={css.dot} aria-hidden="true" />
+            <span>{PERIOD_NOTICE[currentPeriod]}</span>
+          </button>
+        )}
+        content={<PricingPanel state={state} currentPeriod={currentPeriod} />}
+        openDelayMs={350}
+      />
+    </div>
+  )
+}
