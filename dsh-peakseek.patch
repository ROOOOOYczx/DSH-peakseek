diff --git a/packages/client/ui-peak-pricing/src/client/index.ts b/packages/client/ui-peak-pricing/src/client/index.ts
new file mode 100644
index 0000000000..547db1557a
--- /dev/null
+++ b/packages/client/ui-peak-pricing/src/client/index.ts
@@ -0,0 +1,55 @@
+/** Browser half of the composer time hint and official price hover card. */
+
+import type { ClientContext } from '@deepseek-ai/dsh-client-runtime/client'
+// Type-only: pulls the conversation input-right SlotMap declaration.
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import { PeakPricingNotice } from './PeakPricingNotice.tsx'
+import type { PeakPricingInjected } from './contract.ts'
+import type { PricingSnapshot } from '../pricing.ts'
+
+/** Services required by the browser-side slot contribution. */
+export const inject = ['slots']
+
+const PRICING_PATH = '/plugins/deepseek-pricing/data'
+
+function isPricingSnapshot(value: unknown): value is PricingSnapshot {
+  if (typeof value !== 'object' || value === null) return false
+  const snapshot = value as Partial<PricingSnapshot>
+  return typeof snapshot.source === 'string'
+    && typeof snapshot.fetchedAt === 'string'
+    && typeof snapshot.date === 'string'
+    && snapshot.timezone === 'Asia/Shanghai'
+    && (snapshot.currentPeriod === 'idle' || snapshot.currentPeriod === 'peak')
+    && Array.isArray(snapshot.models)
+}
+
+async function readPricing(): Promise<PricingSnapshot> {
+  const response = await fetch(PRICING_PATH, { headers: { accept: 'application/json' } })
+  const payload: unknown = await response.json()
+  if (!response.ok) {
+    const message = typeof payload === 'object' && payload !== null && 'error' in payload
+      ? String(payload.error)
+      : `pricing route returned HTTP ${String(response.status)}`
+    throw new Error(message)
+  }
+  if (!isPricingSnapshot(payload)) throw new Error('pricing route returned an invalid snapshot')
+  return payload
+}
+
+/**
+ * Mount one shared pricing request and register the centered right-side input
+ * entry. All session entries reuse this root-scoped request promise.
+ * @param ctx - browser Cordis context.
+ */
+export function apply(ctx: ClientContext): void {
+  let request: Promise<PricingSnapshot> | undefined
+  const getPricing = (): Promise<PricingSnapshot> => request ??= readPricing()
+  const injected = (): PeakPricingInjected => ({ getPricing })
+
+  ctx.slots.inject('conversation.input.right', () => ctx.slots.register({
+    name: 'conversation.input.right',
+    id: 'deepseek-pricing',
+    order: 10,
+    inject: injected,
+  }, PeakPricingNotice))
+}
