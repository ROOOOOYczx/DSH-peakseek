+/** Package-owned invariant companion for the composer pricing hint plugin. */
+
+/* jscpd:ignore-start */
+import type { Context } from '@deepseek-ai/cordis'
+import type { InvariantInstaller } from '@deepseek-ai/dsh-invariants'
+
+const PACKAGE_NAME = '@deepseek-ai/dsh-client-ui-peak-pricing'
+
+/** Cordis companion plugin name. */
+export const name = 'client-ui-peak-pricing-invariant'
+/** Service required before the companion can reserve package ownership. */
+export const inject = ['invariants']
+
+/** The feature's observable behavior is covered by its parser and UI checks. */
+const install: InvariantInstaller = () => {}
+
+/**
+ * Register this package's invariant companion.
+ * @param ctx - Cordis context carrying the invariant service.
+ * @returns the installed registration's disposer after setup succeeds.
+ */
+export const apply = (ctx: Context): Promise<() => void> =>
+  Promise.resolve(ctx.invariants.register(PACKAGE_NAME, install))
+/* jscpd:ignore-end */
diff --git a/packages/client/ui-peak-pricing/src/pricing.ts b/packages/client/ui-peak-pricing/src/pricing.ts
new file mode 100644
index 0000000000..33adf9e927
--- /dev/null
+++ b/packages/client/ui-peak-pricing/src/pricing.ts
@@ -0,0 +1,186 @@
+/** Runtime parser and wire vocabulary for the official DeepSeek pricing page. */
+
+/** Official source used by the Host fetcher. */
+export const PRICING_SOURCE = 'https://api-docs.deepseek.com/zh-cn/quick_start/pricing/'
+
+/** Price schedule used by the official page. */
+export type PricePeriod = 'idle' | 'peak'
+
+/** One model's per-million-token prices in RMB. */
+export interface ModelPricing {
+  readonly id: string
+  readonly version: string
+  readonly inputCacheHit: Readonly<Record<PricePeriod, number>>
+  readonly inputCacheMiss: Readonly<Record<PricePeriod, number>>
+  readonly output: Readonly<Record<PricePeriod, number>>
+}
+
+/** JSON response sent by the Host pricing route. */
+export interface PricingSnapshot {
+  readonly source: string
+  readonly fetchedAt: string
+  readonly date: string
+  readonly timezone: 'Asia/Shanghai'
+  readonly currentPeriod: PricePeriod
+  readonly models: readonly ModelPricing[]
+}
+
+interface PricingRow {
+  readonly cells: readonly string[]
+}
+
+function htmlText(source: string): string {
+  return source
+    .replace(/<br\s*\/?>/gi, ' ')
+    .replace(/<[^>]+>/g, ' ')
+    .replace(/&#x([0-9a-f]+);/gi, (_, code: string) => String.fromCodePoint(Number.parseInt(code, 16)))
+    .replace(/&#([0-9]+);/g, (_, code: string) => String.fromCodePoint(Number.parseInt(code, 10)))
+    .replace(/&nbsp;/gi, ' ')
+    .replace(/&amp;/gi, '&')
+    .replace(/&lt;/gi, '<')
+    .replace(/&gt;/gi, '>')
+    .replace(/\s+/g, ' ')
+    .trim()
+}
+
+function rowsOf(html: string): readonly PricingRow[] {
+  return [...html.matchAll(/<tr\b[^>]*>([\s\S]*?)<\/tr>/gi)].map(match => ({
+    cells: [...(match[1] ?? '').matchAll(/<t[dh]\b[^>]*>([\s\S]*?)<\/t[dh]>/gi)].map(cell => htmlText(cell[1] ?? '')),
+  }))
+}
+
+function numericPrice(value: string): number | undefined {
+  const match = value.replaceAll(',', '').match(/\d+(?:\.\d+)?/)
+  if (match === null) return undefined
+  const number = Number(match[0])
+  return Number.isFinite(number) ? number : undefined
+}
+
+function requiredPrice(
+  prices: ReadonlyMap<string, ReadonlyMap<PricePeriod, readonly number[]>>,
+  section: string,
+  period: PricePeriod,
+  modelIndex: number,
+): number {
+  const value = prices.get(section)?.get(period)?.[modelIndex]
+  if (value === undefined) {
+    throw new Error(`DeepSeek pricing page is missing ${section}/${period} price for model index ${String(modelIndex)}`)
+  }
+  return value
+}
+
+function halfPeakPrice(
+  prices: ReadonlyMap<string, ReadonlyMap<PricePeriod, readonly number[]>>,
+  section: string,
+  modelIndex: number,
+): { idle: number; peak: number } {
+  const idle = requiredPrice(prices, section, 'idle', modelIndex)
+  const peak = requiredPrice(prices, section, 'peak', modelIndex)
+  const expectedIdle = peak / 2
+  if (Math.abs(idle - expectedIdle) > Number.EPSILON * Math.max(1, Math.abs(expectedIdle))) {
+    throw new Error(`DeepSeek pricing page must keep ${section} idle price at half of peak price for model index ${String(modelIndex)}`)
+  }
+  return { idle, peak }
+}
+
+function requiredRow(rows: readonly PricingRow[], predicate: (row: PricingRow) => boolean, description: string): PricingRow {
+  const row = rows.find(predicate)
+  if (row === undefined) throw new Error(`DeepSeek pricing page is missing ${description}`)
+  return row
+}
+
+/**
+ * Parse the current official pricing table without depending on a DOM library.
+ * The parser keys prices by the table's labels and keeps the model/version order
+ * declared by the page, so an added model column does not reorder existing data.
+ * @param html - HTML returned by the official pricing URL.
+ * @returns the model price rows from the page.
+ */
+export function parsePricingHtml(html: string): readonly ModelPricing[] {
+  const rows = rowsOf(html)
+  const modelRow = requiredRow(rows, row => row.cells[0] === '模型' && row.cells.length >= 2, 'model row')
+  const modelIds = modelRow.cells.slice(1)
+  const versionRow = requiredRow(rows, row => row.cells[0] === '模型版本', 'model version row')
+  const sections = new Map<string, Map<PricePeriod, readonly number[]>>()
+  const sectionNames = [
+    ['百万tokens输入（缓存命中）', 'inputCacheHit'],
+    ['百万tokens输入（缓存未命中）', 'inputCacheMiss'],
+    ['百万tokens输出', 'output'],
+  ] as const
+  let currentSection: string | undefined
+
+  for (const row of rows) {
+    const rowSection = sectionNames.find(([label]) => row.cells.some(cell => cell.includes(label)))?.[1]
+    if (rowSection !== undefined) currentSection = rowSection
+    const section = currentSection
+    const period = row.cells.find(cell => cell.includes('空闲时段')) !== undefined
+      ? 'idle'
+      : row.cells.find(cell => cell.includes('高峰时段')) !== undefined ? 'peak' : undefined
+    if (section === undefined || period === undefined) continue
+    const values = row.cells.slice(-modelIds.length).map(numericPrice)
+    if (values.some(value => value === undefined)) {
+      throw new Error(`DeepSeek pricing page contains an invalid ${section}/${period} row`)
+    }
+    let sectionPrices = sections.get(section)
+    if (sectionPrices === undefined) {
+      sectionPrices = new Map()
+      sections.set(section, sectionPrices)
+    }
+    sectionPrices.set(period, values as number[])
+  }
+
+  return modelIds.map((id, modelIndex) => ({
+    id,
+    version: versionRow.cells[modelIndex + 1] ?? id,
+    inputCacheHit: halfPeakPrice(sections, 'inputCacheHit', modelIndex),
+    inputCacheMiss: halfPeakPrice(sections, 'inputCacheMiss', modelIndex),
+    output: halfPeakPrice(sections, 'output', modelIndex),
+  }))
+}
+
+function beijingParts(now: Date): Readonly<Record<'year' | 'month' | 'day' | 'hour', number>> {
+  const parts = new Intl.DateTimeFormat('en-US', {
+    timeZone: 'Asia/Shanghai',
+    year: 'numeric',
+    month: '2-digit',
+    day: '2-digit',
+    hour: '2-digit',
+    hourCycle: 'h23',
+  }).formatToParts(now)
+  const value = (type: 'year' | 'month' | 'day' | 'hour'): number => {
+    const part = parts.find(item => item.type === type)?.value
+    if (part === undefined) throw new Error(`missing Beijing time part: ${type}`)
+    return Number(part)
+  }
+  return { year: value('year'), month: value('month'), day: value('day'), hour: value('hour') }
+}
+
+/**
+ * Resolve the official page's Beijing-time schedule for the supplied instant.
+ * @param now - instant to classify.
+ * @returns peak during 09:00-12:00 or 14:00-18:00, idle otherwise.
+ */
+export function pricePeriodAt(now: Date): PricePeriod {
+  const hour = beijingParts(now).hour
+  return hour >= 9 && hour < 12 || hour >= 14 && hour < 18 ? 'peak' : 'idle'
+}
+
+/**
+ * Add the current Beijing date and schedule label to parsed prices.
+ * @param models - parsed model rows.
+ * @param fetchedAt - Host fetch completion time.
+ * @param now - instant used for the current schedule label.
+ * @returns the JSON-safe browser response.
+ */
+export function createPricingSnapshot(models: readonly ModelPricing[], fetchedAt: Date, now: Date): PricingSnapshot {
+  const parts = beijingParts(now)
+  const date = `${String(parts.year).padStart(4, '0')}-${String(parts.month).padStart(2, '0')}-${String(parts.day).padStart(2, '0')}`
+  return {
+    source: PRICING_SOURCE,
+    fetchedAt: fetchedAt.toISOString(),
+    date,
+    timezone: 'Asia/Shanghai',
+    currentPeriod: pricePeriodAt(now),
+    models,
+  }
+}
