+import { describe, expect, it } from 'vitest'
+import { createPricingSnapshot, parsePricingHtml, pricePeriodAt } from '../src/pricing.ts'
+
+const HTML = `
+<table>
+  <tr><td>模型</td><td>deepseek-v4-flash</td><td>deepseek-v4-pro</td><td>deepseek-v4-flash-vision-exp</td></tr>
+  <tr><td colspan="4">模型版本</td><td>DeepSeek-V4-Flash-0731</td><td>DeepSeek-V4-Pro-0813</td><td>DeepSeek-V4-Flash-Vision-Exp</td></tr>
+  <tr><td>百万tokens输入<br>（缓存命中）</td><td>空闲时段</td><td>0.05元</td><td>0.15元</td><td>0.05元</td></tr>
+  <tr><td>高峰时段</td><td>0.10元</td><td>0.30元</td><td>0.10元</td></tr>
+  <tr><td>百万tokens输入<br>（缓存未命中）</td><td>空闲时段</td><td>1.5元</td><td>4.5元</td><td>1.5元</td></tr>
+  <tr><td>高峰时段</td><td>3.0元</td><td>9.0元</td><td>3.0元</td></tr>
+  <tr><td>百万tokens输出</td><td>空闲时段</td><td>4.5元</td><td>13.5元</td><td>4.5元</td></tr>
+  <tr><td>高峰时段</td><td>9.0元</td><td>27.0元</td><td>9.0元</td></tr>
+</table>`
+
+describe('official pricing parser', () => {
+  it('maps the official model columns and all schedule rows', () => {
+    expect(parsePricingHtml(HTML)).toEqual([
+      {
+        id: 'deepseek-v4-flash',
+        version: 'DeepSeek-V4-Flash-0731',
+        inputCacheHit: { idle: 0.05, peak: 0.1 },
+        inputCacheMiss: { idle: 1.5, peak: 3 },
+        output: { idle: 4.5, peak: 9 },
+      },
+      {
+        id: 'deepseek-v4-pro',
+        version: 'DeepSeek-V4-Pro-0813',
+        inputCacheHit: { idle: 0.15, peak: 0.3 },
+        inputCacheMiss: { idle: 4.5, peak: 9 },
+        output: { idle: 13.5, peak: 27 },
+      },
+      {
+        id: 'deepseek-v4-flash-vision-exp',
+        version: 'DeepSeek-V4-Flash-Vision-Exp',
+        inputCacheHit: { idle: 0.05, peak: 0.1 },
+        inputCacheMiss: { idle: 1.5, peak: 3 },
+        output: { idle: 4.5, peak: 9 },
+      },
+    ])
+  })
+
+  it('uses the official Beijing weekday peak windows', () => {
+    expect(pricePeriodAt(new Date('2026-08-19T00:59:00.000Z'))).toBe('idle')
+    expect(pricePeriodAt(new Date('2026-08-19T01:00:00.000Z'))).toBe('peak')
+    expect(pricePeriodAt(new Date('2026-08-19T03:59:00.000Z'))).toBe('peak')
+    expect(pricePeriodAt(new Date('2026-08-19T04:00:00.000Z'))).toBe('idle')
+    expect(pricePeriodAt(new Date('2026-08-19T05:59:00.000Z'))).toBe('idle')
+    expect(pricePeriodAt(new Date('2026-08-19T06:00:00.000Z'))).toBe('peak')
+    expect(pricePeriodAt(new Date('2026-08-19T09:59:00.000Z'))).toBe('peak')
+    expect(pricePeriodAt(new Date('2026-08-19T10:00:00.000Z'))).toBe('idle')
+    expect(pricePeriodAt(new Date('2026-08-22T01:00:00.000Z'))).toBe('idle')
+    expect(pricePeriodAt(new Date('2026-08-23T06:00:00.000Z'))).toBe('idle')
+  })
+
+  it('keeps idle prices at exactly half the peak prices', () => {
+    for (const model of parsePricingHtml(HTML)) {
+      expect(model.inputCacheHit.idle).toBe(model.inputCacheHit.peak / 2)
+      expect(model.inputCacheMiss.idle).toBe(model.inputCacheMiss.peak / 2)
+      expect(model.output.idle).toBe(model.output.peak / 2)
+    }
+  })
+
+  it('returns a JSON-safe snapshot with the current Beijing date', () => {
+    const models = parsePricingHtml(HTML)
+    expect(createPricingSnapshot(models, new Date('2026-08-19T00:00:00.000Z'), new Date('2026-08-19T01:00:00.000Z'))).toMatchObject({
+      date: '2026-08-19',
