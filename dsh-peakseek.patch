+/** Host half of the composer pricing hint. */
+
+import type { Context } from '@deepseek-ai/cordis'
+// Type-only import activates the webServer Context merge used by the route.
+import type {} from '@deepseek-ai/dsh-host-webserver'
+import { createPricingSnapshot, parsePricingHtml, PRICING_SOURCE, type PricingSnapshot } from './pricing.ts'
+
+/** Stable Cordis plugin name. */
+export const name = 'client-ui-peak-pricing'
+/** The Host route is available only after the shared web server is ready. */
+export const inject = ['webServer']
+
+const PRICING_PATH = '/plugins/deepseek-pricing/data'
+const CACHE_TTL_MS = 15 * 60 * 1000
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error)
+}
+
+/**
+ * Fetch the official pricing page and expose a same-origin JSON response to the
+ * browser plugin. The response is cached for 15 minutes, while the current
+ * Beijing idle/peak label is recalculated on each request.
+ * @param ctx - Host context carrying the web server.
+ */
+export function apply(ctx: Context): void {
+  let cached: { snapshot: PricingSnapshot; expiresAt: number } | undefined
+  let inFlight: Promise<PricingSnapshot> | undefined
+
+  const load = async (): Promise<PricingSnapshot> => {
+    const now = Date.now()
+    if (cached !== undefined && cached.expiresAt > now) {
+      return createPricingSnapshot(cached.snapshot.models, new Date(cached.snapshot.fetchedAt), new Date())
+    }
+    if (inFlight !== undefined) return inFlight
+    inFlight = (async () => {
+      const response = await fetch(PRICING_SOURCE, { headers: { accept: 'text/html' } })
+      if (!response.ok) throw new Error(`official pricing page returned HTTP ${String(response.status)}`)
+      const models = parsePricingHtml(await response.text())
+      const fetchedAt = new Date()
+      const snapshot = createPricingSnapshot(models, fetchedAt, fetchedAt)
+      cached = { snapshot, expiresAt: Date.now() + CACHE_TTL_MS }
+      return snapshot
+    })().finally(() => { inFlight = undefined })
+    return inFlight
+  }
+
+  ctx.effect(() => ctx.webServer.register({
+    kind: 'exact',
+    path: PRICING_PATH,
+    handler: async (req, res) => {
+      if (req.method !== 'GET' && req.method !== 'HEAD') {
+        res.writeHead(405, { allow: 'GET, HEAD' })
+        res.end()
+        return
+      }
+      try {
+        const body = JSON.stringify(await load())
+        res.writeHead(200, {
+          'cache-control': 'public, max-age=300',
+          'content-type': 'application/json; charset=utf-8',
+        })
+        res.end(req.method === 'HEAD' ? undefined : body)
+      } catch (error) {
+        res.writeHead(502, { 'content-type': 'application/json; charset=utf-8' })
+        res.end(JSON.stringify({ error: errorMessage(error) }))
+      }
+    },
+  }), 'client-ui-peak-pricing: official pricing route')
+}
