diff --git a/start-dsh.bat b/start-dsh.bat
new file mode 100644
index 0000000000..e03f168e01
--- /dev/null
+++ b/start-dsh.bat
@@ -0,0 +1,44 @@
+@echo off
+setlocal
+title DeepSeek Harness
+
+cd /d "%~dp0"
+
+rem Use the user-local portable Node.js installed for this machine.
+set "NODE_PORTABLE=%LOCALAPPDATA%\Programs\nodejs-portable"
+if exist "%NODE_PORTABLE%\node.exe" set "PATH=%NODE_PORTABLE%;%PATH%"
+
+rem Make the user-local pnpm installation available in fresh cmd windows.
+set "PNPM_BIN=%LOCALAPPDATA%\pnpm\bin"
+if exist "%PNPM_BIN%\pnpm.cmd" set "PATH=%PNPM_BIN%;%PATH%"
+
+where node >nul 2>&1
+if errorlevel 1 (
+    echo [ERROR] Node.js was not found.
+    echo Please reinstall Node.js or check the user PATH.
+    pause
+    exit /b 1
+)
+
+where pnpm >nul 2>&1
+if errorlevel 1 (
+    echo [ERROR] pnpm was not found.
+    echo Please install pnpm 11.7.0 with: npm install --global pnpm@11.7.0
+    pause
+    exit /b 1
+)
+
+echo Starting DeepSeek Harness Web UI...
+echo URL: http://127.0.0.1:3080
+echo Press Ctrl+C to stop the service.
+echo.
+
+pnpm dsh web
+
+if errorlevel 1 (
+    echo.
+    echo [ERROR] DeepSeek Harness failed to start.
+    pause
+)
+
+endlocal
